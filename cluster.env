CLUSTER_NAME=nt131-scc

API_VIP=172.31.9.250
VIP_INTERFACE=eth0
NODE_INTERFACE=eth0
NODE_PREFIX=22
NODE_GATEWAY=172.31.8.1
NODE_DNS_SERVERS="172.31.8.1 1.1.1.1 8.8.8.8"
K3S_TOKEN=nt131-super-secret-token
K3S_VERSION=v1.29.6+k3s2
KUBEVIP_VERSION=v0.8.0

MASTER1_HOST=master1
MASTER1_IP=172.31.9.11
MASTER2_HOST=master2
MASTER2_IP=172.31.9.12
MASTER3_HOST=master3
MASTER3_IP=172.31.9.13

WORKER1_HOST=worker1
WORKER1_IP=172.31.9.21
WORKER2_HOST=worker2
WORKER2_IP=172.31.9.22

MASTER1_USER=master1
MASTER2_USER=master2
MASTER3_USER=master3
WORKER1_USER=worker1
WORKER2_USER=worker2
SSH_PASSWORD=123

KUBECONFIG_LOCAL=$HOME/.kube/nt131-k3s.yaml

NAMESPACE=slm
APP_NAME=slm-api
SLM_IMAGE=ghcr.io/ggerganov/llama.cpp:full
SLM_PORT=8080
INGRESS_HOST=slm.local
HPA_MIN_REPLICAS=1
HPA_MAX_REPLICAS=4
HPA_CPU_PERCENT=60

HF_MODEL_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF
HF_MODEL_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf
MODEL_CACHE_HOST_PATH=/var/lib/slm-model-cache
LLM_CONTEXT_SIZE=2048
LLM_MAX_TOKENS=128
LLM_PARALLEL=2
LLM_THREADS=4

LOADGEN_IMAGE=grafana/k6:0.49.0
LOADGEN_VUS=20
LOADGEN_DURATION=120s
LOADGEN_BASE_URL=http://slm-api.slm.svc.cluster.local
